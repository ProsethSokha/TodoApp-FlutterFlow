{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "description": "Schema for task documents in the Todo application's Firestore tasks collection.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "completed": {
      "type": "boolean"
    },
    "user": {
      "description": "Firestore document reference to a user document.",
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    }
  }
}